#!/usr/bin/env bash
# immich-autotag pre-push: WHOLE-REPO darnlink wall, OFFLINE (the web pass runs only in Jenkins), with the fleet's
# shared recipe (darnlink-gate) and the pin in darnlink-gate.json. Run by the global git-hooks dispatcher.
# Bypass (discouraged): git push --no-verify
set -euo pipefail
command -v darnlink-gate >/dev/null 2>&1 || { echo "darnlink pre-push: darnlink-gate not on PATH -> SKIP (CI covers it)." >&2; exit 0; }
export DARNLINK_GATE_WEB=0
exec darnlink-gate
