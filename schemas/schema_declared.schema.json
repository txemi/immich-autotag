            "pattern": "\\S",
            "type": "string"
        },
        "exempt": {
            "items": {
                "$ref": "#/$defs/Entry"
            },
            "type": "array"
        },
        "pending": {
            "items": {
                "$ref": "#/$defs/Entry"
            },
            "type": "array"
        },
        "pinned": {
            "additionalProperties": {
                "anyOf": [
                    {
                        "$ref": "#/$defs/PinnedCopy__identifier_optional"
                    },
                    {
                        "type": "string"
                    }
                ]
            },
            "description": "url of a schema declared by url -> path in the repo of its pinned copy, to validate offline",
            "type": [
                "object",
                "null"
            ]
        }
